local NOMES_DIRECAO = {"N", "NE", "L", "SE", "S", "SO", "O", "NO"}

-- Atualiza a bússola todo frame (Norte = direção -Z do mapa)
local function atualizarBussola()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local olhar = cam.CFrame.LookVector
	local grau = math.deg(math.atan2(olhar.X, -olhar.Z)) % 360
	disco.Rotation = -grau

	local indice = math.floor((grau + 22.5) / 45) % 8 + 1
	lblDirecao.Text = string.format("%s\n%d°", NOMES_DIRECAO[indice], grau)

	local hrp = getHRP()
	if hrp then
		local p = hrp.Position
		lblPos.Text = string.format("X %d  Z %d", p.X, p.Z)
		lblAltura.Text = string.format("Altura: %d", p.Y)
		lblDist.Text = posMarcada
			and string.format("Distância: %.1f", (p - posMarcada).Magnitude)
			or "Distância: --"
	else
		lblPos.Text, lblAltura.Text, lblDist.Text = "X --  Z --", "Altura: --", "Distância: --"
	end
end

ligar(RunService.RenderStepped, atualizarBussola)

