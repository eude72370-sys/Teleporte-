-- ========== FUNÇÕES: MARCAR / TELEPORTAR ==========
local function marcarPosicao()
	local hrp = getHRP()
	if not hrp then return false end
	posMarcada = hrp.Position
	-- CFrame reto (sem inclinar) e meio stud acima, para nascer em pé e sem entrar no chão
	local p = hrp.Position + Vector3.new(0, 0.5, 0)
	local olhar = hrp.CFrame.LookVector
	cfMarcado = CFrame.new(p, p + Vector3.new(olhar.X, 0, olhar.Z))
	return true
end

-- Teleporta para a posição fixa (LOCAL_TELEPORTE)
local function teleportarFixo()
	local hrp = getHRP()
	if not hrp then return false end
	hrp.CFrame = CFrame.new(LOCAL_TELEPORTE)
	return true
end

-- Ao nascer: te leva rápido para o local marcado, antes de você ficar no spawn do jogo.
-- Repete por alguns frames caso o jogo tente te mandar de volta ao spawn.
local function renascerNoLocal(char)
	if not renascerOn or not cfMarcado then
		capa.Visible = false
		return
	end
	capa.Visible = true -- a capa preta só aparece no instante em que você nasce
	local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
	if not hrp then
		capa.Visible = false
		return
	end
	local alvo = cfMarcado
	hrp.CFrame = alvo -- teleporte imediato, sem esperar nenhum frame
	hrp.AssemblyLinearVelocity = Vector3.zero
	task.delay(RENASCER.fade, function() capa.Visible = false end) -- tira a capa preta

	-- Só reteleporta se o jogo te puxar de volta (longe do ponto na horizontal).
	-- Fora isso, a física fica livre: você cai e fica em pé normalmente, sem voar.
	local fim = os.clock() + RENASCER.segurar
	while os.clock() < fim do
		if not vivo or not renascerOn or LocalPlayer.Character ~= char or not hrp.Parent then break end
		local dx = hrp.Position.X - alvo.Position.X
		local dz = hrp.Position.Z - alvo.Position.Z
		if math.sqrt(dx * dx + dz * dz) > RENASCER.afastamento then
			hrp.CFrame = alvo
			hrp.AssemblyLinearVelocity = Vector3.zero
		end
		RunService.Heartbeat:Wait()
	end
end

-- ========== FUNÇÃO: REINICIAR AO LEVAR DANO ==========
-- Se a vida cair (e não for logo ao nascer), zera a vida = o personagem reinicia
local function vigiarDano(char)
	if conexaoDano then conexaoDano:Disconnect() end
	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then return end
	local nasceu = os.clock()
	local ultima = hum.Health
	conexaoDano = hum.HealthChanged:Connect(function(vida)
		if reiniciarOn and vida > 0 and vida < ultima
			and os.clock() - nasceu > DANO.graca then
			hum.Health = 0
		end
		ultima = vida
	end)
end

